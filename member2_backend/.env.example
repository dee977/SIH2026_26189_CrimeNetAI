PROJECT_NAME="CrimeNet AI Backend"
ENVIRONMENT="development"
DEBUG="True"

# API & Security
API_V1_STR="/api/v1"
SECRET_KEY="crimenet-ai-super-secret-jwt-key-sih-2026-replace-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="480"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8000"

# Local Database & Auth (Supabase/PostgreSQL)
# For local dev, you can use a local SQLite file (sqlite:///./crimenet.db) or remote Postgres.
DATABASE_URL="sqlite:///./crimenet.db"
# Replace with actual Supabase details if developing with Supabase
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-role-key"

# Neo4j Graph Database
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"

# Background Tasks & Redis (Optional for local dev without Celery workers running)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Microservices URLs (M3, M4, M5, M6)
# If DOWNSTREAM_FALLBACK_MODE is True, missing microservices will be gracefully mocked.
M3_DATA_GRAPH_SERVICE_URL="http://localhost:8003"
M4_AI_NLP_SERVICE_URL="http://localhost:8004"
M5_GRAPH_ML_SERVICE_URL="http://localhost:8005"
M6_SECURITY_SERVICE_URL="http://localhost:8006"
DOWNSTREAM_FALLBACK_MODE="True"
